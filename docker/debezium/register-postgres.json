{
  "name": "postgres-outbox-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "plugin.name": "pgoutput",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "pulserank",
    "database.password": "pulserank",
    "database.dbname": "pulserank",
    "topic.prefix": "pulserank-db",
    "table.include.list": "public.products_outbox",
    "tombstones.on.delete": "false",
    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.route.topic.replacement": "pulserank.catalog.product-changes.v1",
    "transforms.outbox.table.field.event.id": "id",
    "transforms.outbox.table.field.event.key": "product_id",
    "transforms.outbox.table.field.event.type": "operation",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.table.field.event.timestamp": "created_at",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.converters.ByteArrayConverter"
  }
}